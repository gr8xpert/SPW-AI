# ===========================================
# SPW API - Environment Configuration
# ===========================================

# Application
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
DASHBOARD_URL=http://localhost:3000

# Reverse-proxy trust (production-critical — see .env.production.template).
# In dev the API is hit directly so we leave this unset. In production set
# TRUST_PROXY=loopback for nginx-on-same-host, or an explicit CIDR list.
# TRUST_PROXY=loopback

# Database
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=spw_v2_dev
DATABASE_USER=root
DATABASE_PASSWORD=password
DATABASE_LOGGING=true
DATABASE_SYNCHRONIZE=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
# Both secrets are REQUIRED. App refuses to start if either is missing or < 32 chars.
# Generate each with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# Encryption (for sensitive data in DB)
ENCRYPTION_KEY=32-character-encryption-key-here

# System SMTP (platform emails — verification, password reset).
# When SMTP_HOST is empty, outgoing messages are logged instead of sent.
# SMTP_FROM is required once SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=
SMTP_FROM_NAME=

# Stripe (plan subscriptions + credit hours)
# Leave blank to disable Stripe checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/dashboard/billing?stripe=success
STRIPE_CANCEL_URL=http://localhost:3000/dashboard/billing?stripe=cancel
STRIPE_GRACE_DAYS=7

# Cloudflare R2 / S3 (image storage)
# Leave blank to use local filesystem storage
DEFAULT_S3_BUCKET=
DEFAULT_S3_REGION=auto
DEFAULT_S3_ACCESS_KEY=
DEFAULT_S3_SECRET_KEY=
DEFAULT_S3_ENDPOINT=
DEFAULT_CDN_URL=

# OpenRouter (AI chat + enrichment) — platform-wide model defaults.
# Per-tenant overrides live in tenant.openrouterApiKey + settings.openRouterModel.
# Leave blank to use the hardcoded fallback model IDs; set to swap defaults
# without a code deploy. Pick model IDs from https://openrouter.ai/models.
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=
OPENROUTER_ENRICHMENT_MODEL=

# Anthropic (direct) — platform AI work goes here first, paid from our
# monthly Anthropic credit; OpenRouter takes over when this is unset, the
# call fails, or this month's estimated spend reaches the budget.
# Client keys (Settings → AI) are not affected.
ANTHROPIC_API_KEY=
# Claude model ID as Anthropic names it (default claude-haiku-5-5).
ANTHROPIC_PLATFORM_MODEL=
# US dollars per calendar month before switching to OpenRouter (default 190).
ANTHROPIC_MONTHLY_BUDGET_USD=

# --- SPM plugin licences (SPM AI Translator for Polylang, sold on realtysoft.eu) ---
# Stripe Payment Links carry metadata spm_product=spm-ai-translator + spm_plan=<pro_single|pro_5|agency|credits_100k|credits_300k|credits_1m>
# (on the link AND in subscription_data.metadata). They reuse STRIPE_WEBHOOK_SECRET / the same webhook endpoint.
# Secret for signed 10-minute plugin download links (any long random string). Without it, updates show but cannot download.
PLUGIN_DOWNLOAD_SECRET=
# Folder with <product>/latest.json {"version","file","requires","requires_php","tested","changelog_html"} and the release zips.
PLUGIN_RELEASES_DIR=
# Public base URL of this API, used in download links (default https://api.spw-ai.com).
PUBLIC_API_URL=
# Links shown to buyers.
PLUGIN_RENEW_URL=https://realtysoft.eu/en/ai-translator-for-polylang/#pricing
PLUGIN_DOWNLOAD_PAGE_URL=https://realtysoft.eu/en/ai-translator-for-polylang/
# SPM AI credits: model and a separate monthly cap (USD) so plugin traffic never pauses other platform AI. Uses ANTHROPIC_API_KEY.
PLUGIN_AI_MODEL=claude-haiku-5-5
PLUGIN_AI_MONTHLY_BUDGET_USD=
# Keys are issued by a super admin (Admin -> Plugin licences). Set to true only to issue keys
# automatically from Stripe Payment Links tagged spm_product=spm-ai-translator.
PLUGIN_STRIPE_AUTO_ISSUE=false
